{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://deaddict.invalid/contracts/account-operations.schema.json",
  "title": "DeAddict account operation contracts",
  "type": "object",
  "additionalProperties": false,
  "required": ["exportRequest", "deletionRequest", "revokeSessionsRequest", "successEnvelope", "errorEnvelope"],
  "properties": {
    "exportRequest": { "$ref": "#/$defs/exportRequest" },
    "deletionRequest": { "$ref": "#/$defs/deletionRequest" },
    "revokeSessionsRequest": { "$ref": "#/$defs/revokeSessionsRequest" },
    "successEnvelope": { "$ref": "#/$defs/successEnvelope" },
    "errorEnvelope": { "$ref": "#/$defs/errorEnvelope" }
  },
  "$defs": {
    "exportRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["format"],
      "properties": {
        "format": { "const": "json" }
      }
    },
    "deletionRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["confirmation"],
      "properties": {
        "confirmation": { "const": "DELETE" }
      }
    },
    "revokeSessionsRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["scope"],
      "properties": {
        "scope": { "const": "all" }
      }
    },
    "successEnvelope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ok", "data", "correlationId"],
      "properties": {
        "ok": { "const": true },
        "data": { "type": "object" },
        "correlationId": { "$ref": "#/$defs/correlationId" }
      }
    },
    "errorEnvelope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ok", "error", "correlationId"],
      "properties": {
        "ok": { "const": false },
        "error": {
          "type": "object",
          "additionalProperties": false,
          "required": ["code", "message"],
          "properties": {
            "code": {
              "enum": [
                "AUTH_REQUIRED",
                "RECENT_AUTH_REQUIRED",
                "INVALID_REQUEST",
                "CONFLICT",
                "RATE_LIMITED",
                "TEMPORARILY_UNAVAILABLE"
              ]
            },
            "message": { "type": "string", "minLength": 1, "maxLength": 180 }
          }
        },
        "correlationId": { "$ref": "#/$defs/correlationId" }
      }
    },
    "correlationId": {
      "type": "string",
      "minLength": 8,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9_-]+$"
    }
  }
}